# 複製成 .env.local，再填入 Firebase 主控台 → 專案設定 → 你的應用程式 → 網頁應用程式的設定。
# 這些值會進到建置後的前端程式，存取控制靠 Firebase Authentication 與 firestore.rules。
# 全部留空時，網站只使用 localStorage，不顯示「使用 Google 登入」。
# 不要把填好的 .env 或 .env.local 提交到 git。

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
